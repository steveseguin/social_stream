+			function removeHtmlTagsFromPlainTextField(value) {
+				return String(value || "")
+					.replace(/<script\b[^>]*>[\s\S]*?<\/script>/gi, "")
+					.replace(/<style\b[^>]*>[\s\S]*?<\/style>/gi, "")
+					.replace(/<noscript\b[^>]*>[\s\S]*?<\/noscript>/gi, "")
+					.replace(/<template\b[^>]*>[\s\S]*?<\/template>/gi, "")
+					.replace(/<[^>]*>/g, "");
+			}
+
+			function plainTextField(value) {
+				if (typeof value !== "string") {
+					return value;
+				}
+				if (typeof stripHtmlToPlainText === "function") {
+					return stripHtmlToPlainText(value);
+				}
+				try {
+					if (typeof DOMParser !== "undefined") {
+						var doc = new DOMParser().parseFromString(value, "text/html");
+						if (doc && doc.body) {
+							var blocked = doc.body.querySelectorAll("script,style,noscript,template");
+							for (var i = 0; i < blocked.length; i++) {
+								blocked[i].remove();
+							}
+							return removeHtmlTagsFromPlainTextField(doc.body.textContent || "");
+						}
+					}
+				} catch (e) {}
+				return removeHtmlTagsFromPlainTextField(value);
+			}
+
+			function sanitizePlainTextAlertFields(data) {
+				if (!data) {
+					return;
+				}
+				["hasDonation", "donation", "membership", "hasMembership", "subtitle", "title"].forEach(function (field) {
+					if (typeof data[field] === "string") {
+						data[field] = plainTextField(data[field]);
+					}
+				});
+			}
+
+			function plainTextToHtml(value) {
+				return escapeHtml(value == null ? "" : value);
+			}
